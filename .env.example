# Leon environment contract — see docs/50-operations/500_DEPLOYMENT_AND_ENVIRONMENT.md
# Copy to .env and fill secrets. NEVER commit .env ([310] SEC-2).

# --- Application ---
BIND_HOST=127.0.0.1            # SEC-1: do not bind a public interface
BIND_PORT=8000

# --- Embedding (HARD, ADR-0018 — do not change without a CR + re-embed) ---
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- Reranker (config) ---
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Generation / Critique (provider-agnostic, ADR-0022) ---
GENERATION_PROVIDER=gemini             # gemini | openrouter
GENERATION_MODEL=gemini-2.0-flash      # operator-selected; e.g. gemini-2.5-flash
CRITIQUE_MODEL=                        # empty => same as GENERATION_MODEL (A-2)

# --- Retrieval sizing & fusion ([240]/ADR-0014) ---
K_DENSE=20
K_SPARSE=20
TOP_N=5
K_RRF=60

# --- Vector index ([230]/ADR-0006) ---
HNSW_M=16
HNSW_EF_CONSTRUCTION=64

# --- Control-flow thresholds & retry ([210]; provisional until calibrated) ---
T_RELEVANCE=0.70
T_GROUNDEDNESS=0.80
MAX_REFORMULATIONS=2

# --- Citation verification ([220]/ADR-0019) ---
CITATION_FUZZY_THRESHOLD=0.95

# --- Timeouts & limits ---
MODEL_CALL_TIMEOUT_MS=30000
RATE_LIMIT_RPM=60

# --- Corpus ([130]) ---
CORPUS_VERSION=corpus-v1.0

# --- Secrets (env only) ---
DATABASE_URL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
POSTGRES_PASSWORD=leon
